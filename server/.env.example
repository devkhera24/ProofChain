NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/proofchain?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173
AI_MOCK=true
# Text generation: Claude by default (AI_PROVIDER=gemini switches it back to Gemini)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# low | medium | high | xhigh | max — how much the model thinks (speed and cost vs. depth)
ANTHROPIC_EFFORT=medium
# Embeddings always use Gemini (and GEMINI_MODEL is used only when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
AI_CONCURRENCY=2
VECTOR_SEARCH_MODE=atlas
VECTOR_INDEX_NAME=passage_vector_index
S2_API_KEY=
CONTACT_EMAIL=you@example.com
MAX_UPLOAD_MB=15
# Run the first recommendation batch automatically after a project's first source is ready
AUTO_RECOMMEND=true
# Must be "true" to run `npm run seed:demo` (creates the demo account and project)
ALLOW_SEED=
